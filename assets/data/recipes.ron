     tech: Some("advanced_materials")),
    (id: "shop_drill_head", machine: "machine_shop", time: 18.0,
     inputs: [("tungsten_carbide", 3), ("bearing", 1), ("steel_rod", 2)], outputs: [("drill_head", 1)],
     tech: Some("advanced_materials")),
    (id: "shop_tungsten_drill", machine: "machine_shop", time: 20.0,
     inputs: [("drill_head", 1), ("battery_pack", 2), ("stainless_plate", 2), ("rare_earth_magnet", 1)],
     outputs: [("tungsten_drill", 1)], tech: Some("deep_crust")),
    (id: "shop_ore_scanner", machine: "machine_shop", time: 12.0,
     inputs: [("circuit_mk1", 1), ("glass_lens", 2), ("battery_pack", 1)], outputs: [("ore_scanner", 1)],
     tech: Some("advanced_materials")),
    (id: "shop_stainless_casing", machine: "machine_shop", time: 10.0,
     inputs: [("stainless_plate", 2)], outputs: [("stainless_casing", 1)], tech: Some("advanced_materials")),
    (id: "shop_zirconium_tubing", machine: "machine_shop", time: 10.0,
     inputs: [("zirconium_ingot", 2)], outputs: [("zirconium_tubing", 2)], tech: Some("fuel_fabrication")),

    // ===== RARE EARTH SEPARATOR (Era 4) ===================================
    (id: "rare_earth_magnet", machine: "rare_earth_separator", time: 14.0,
     inputs: [("monazite_sand", 3), ("sulfuric_acid", 1)], outputs: [("rare_earth_magnet", 1)],
     tech: Some("advanced_materials")),
    (id: "rare_earth_zirconium", machine: "rare_earth_separator", time: 12.0,
     inputs: [("monazite_sand", 2)], outputs: [("zirconium_ingot", 1)], tech: Some("advanced_materials")),

    // ===== NUCLEAR CHAIN (Era 5) ==========================================
    (id: "leach_uranium", machine: "leaching_tank", time: 20.0,
     inputs: [("crushed_uranium_ore", 2), ("sulfuric_acid", 1)],
