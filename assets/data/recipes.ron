    (id: "convert_uf6", machine: "conversion_plant", time: 18.0,
     inputs: [("yellowcake", 1), ("fluorine_compound", 1)], outputs: [("uf6_canister", 1)],
     tech: Some("conversion")),
    (id: "enrich_uranium", machine: "centrifuge", time: 40.0,
     inputs: [("uf6_canister", 1)], outputs: [("enriched_canister", 1), ("depleted_canister", 1)],
     tech: Some("enrichment")),
    (id: "fabricate_fuel_rod", machine: "fuel_fabricator", time: 24.0,
     inputs: [("enriched_canister", 1), ("zirconium_tubing", 2)], outputs: [("fuel_rod", 1)],
     tech: Some("fuel_fabrication")),
    (id: "fabricate_core_cell", machine: "fuel_fabricator", time: 30.0,
     inputs: [("enriched_canister", 1), ("stainless_casing", 1), ("lead_shielding", 1)],
     outputs: [("compact_core_cell", 1)], tech: Some("fuel_fabrication")),
    (id: "fabricate_control_rod", machine: "fuel_fabricator", time: 20.0,
     inputs: [("cadmium", 2), ("stainless_plate", 1)], outputs: [("control_rod", 1)],
     tech: Some("reactor_engineering")),
    (id: "cool_spent_fuel", machine: "cooling_pool", time: 120.0,
     inputs: [("spent_fuel", 1)], outputs: [("waste_cask", 1)], tech: Some("waste_handling")),
    (id: "cool_spent_cell", machine: "cooling_pool", time: 120.0,
     inputs: [("spent_core_cell", 1)], outputs: [("waste_cask", 1)], tech: Some("waste_handling")),
    (id: "build_nuclear_drill", machine: "machine_shop", time: 40.0,
     inputs: [("compact_core_cell", 1), ("drill_head", 2), ("stainless_plate", 6),
              ("rare_earth_magnet", 2), ("lead_shielding", 2)],
     outputs: [("nuclear_drill", 1)], tech: Some("nuclear_drill")),
    (id: "repack_core_cell", machine: "fuel_fabricator", time: 20.0,
     inputs: [("spent_core_cell", 1)], outputs: [("spent_fuel", 1)], tech: Some("waste_handling")),
]
