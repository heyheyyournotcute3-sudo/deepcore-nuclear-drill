// Deepcore recipes.
//
// Every recipe names the machine that runs it. The Workbench runs hand crafting (no energy);
// everything else needs its machine built and, usually, researched.
[
    // ===== WORKBENCH (Era 0 hand crafting) ================================
    (id: "bench_stone_brick", machine: "workbench", time: 2.0,
     inputs: [("stone_cobble", 4)], outputs: [("stone_brick", 4)]),
    (id: "bench_timber_support", machine: "workbench", time: 2.0,
     inputs: [("timber", 4)], outputs: [("timber_support", 4)]),
    (id: "bench_ladder", machine: "workbench", time: 2.0,
     inputs: [("timber", 3)], outputs: [("ladder", 4)]),
    (id: "bench_storage_crate", machine: "workbench", time: 3.0,
     inputs: [("timber", 10)], outputs: [("storage_crate", 1)]),
    (id: "bench_brick_kiln", machine: "workbench", time: 4.0,
     inputs: [("clay", 20), ("stone_cobble", 10)], outputs: [("brick_kiln", 1)]),
    (id: "bench_stone_furnace", machine: "workbench", time: 4.0,
     inputs: [("stone_cobble", 24), ("bricks", 8)], outputs: [("stone_furnace", 1)], tech: Some("smelting")),
    (id: "bench_research_desk", machine: "workbench", time: 3.0,
     inputs: [("timber", 16), ("stone_cobble", 8)], outputs: [("research_desk", 1)]),
    (id: "bench_charcoal", machine: "workbench", time: 3.0,
     inputs: [("timber", 2)], outputs: [("charcoal", 1)]),
    (id: "bench_oil_lamp", machine: "workbench", time: 2.0,
     inputs: [("clay", 2), ("charcoal", 1)], outputs: [("oil_lamp", 2)]),

    // ===== BRICK KILN (Era 1) =============================================
    (id: "kiln_bricks", machine: "brick_kiln", time: 4.0,
     inputs: [("clay", 2)], outputs: [("bricks", 2)]),
    (id: "kiln_fire_brick", machine: "brick_kiln", time: 8.0,
     inputs: [("bricks", 2), ("limestone", 1)], outputs: [("fire_brick", 2)]),
    (id: "kiln_glass", machine: "brick_kiln", time: 6.0,
     inputs: [("sand", 2)], outputs: [("glass_pane", 2)]),

    // ===== STONE FURNACE (Era 1 smelting) =================================
    (id: "smelt_copper", machine: "stone_furnace", time: 5.0,
     inputs: [("raw_copper", 1)], outputs: [("copper_ingot", 1)]),
    (id: "smelt_tin", machine: "stone_furnace", time: 5.0,
     inputs: [("raw_tin", 1)], outputs: [("tin_ingot", 1)]),
    (id: "smelt_iron", machine: "stone_furnace", time: 6.0,
     inputs: [("raw_iron", 1)], outputs: [("iron_ingot", 1)]),
    (id: "smelt_lead", machine: "stone_furnace", time: 6.0,
     inputs: [("raw_lead", 1)], outputs: [("lead_ingot", 1)]),
    (id: "smelt_zinc", machine: "stone_furnace", time: 6.0,
     inputs: [("raw_zinc", 1)], outputs: [("zinc_ingot", 1)]),
    (id: "smelt_gold", machine: "stone_furnace", time: 8.0,
     inputs: [("raw_gold", 1)], outputs: [("gold_ingot", 1)]),
    (id: "smelt_bronze", machine: "stone_furnace", time: 8.0,
     inputs: [("copper_ingot", 3), ("tin_ingot", 1)], outputs: [("bronze_ingot", 4)]),
    (id: "smelt_brass", machine: "stone_furnace", time: 8.0,
     inputs: [("copper_ingot", 3), ("zinc_ingot", 1)], outputs: [("brass_ingot", 4)]),
    (id: "smelt_zinc_cadmium", machine: "stone_furnace", time: 10.0,
     inputs: [("raw_zinc", 4)], outputs: [("zinc_ingot", 3), ("cadmium", 1)], tech: Some("metallurgy")),

    // ===== ANVIL (Era 1 shaping) ==========================================
    (id: "anvil_iron_plate", machine: "anvil", time: 3.0,
     inputs: [("iron_ingot", 1)], outputs: [("iron_plate", 1)]),
    (id: "anvil_copper_plate", machine: "anvil", time: 3.0,
     inputs: [("copper_ingot", 1)], outputs: [("copper_plate", 1)]),
    (id: "anvil_lead_plate", machine: "anvil", time: 3.0,
     inputs: [("lead_ingot", 1)], outputs: [("lead_plate", 1)]),
    (id: "anvil_steel_plate", machine: "anvil", time: 4.0,
     inputs: [("steel_ingot", 1)], outputs: [("steel_plate", 1)], tech: Some("steelmaking")),
    (id: "anvil_iron_rod", machine: "anvil", time: 3.0,
     inputs: [("iron_ingot", 1)], outputs: [("iron_rod", 2)]),
    (id: "anvil_copper_rod", machine: "anvil", time: 3.0,
     inputs: [("copper_ingot", 1)], outputs: [("copper_rod", 2)]),
    (id: "anvil_copper_pipe", machine: "anvil", time: 4.0,
     inputs: [("copper_ingot", 2)], outputs: [("copper_pipe", 2)]),
    (id: "anvil_copper_cable", machine: "anvil", time: 3.0,
     inputs: [("copper_rod", 1)], outputs: [("copper_cable", 2)]),
    (id: "anvil_iron_gear", machine: "anvil", time: 4.0,
     inputs: [("iron_ingot", 2)], outputs: [("iron_gear", 1)]),
    (id: "anvil_bronze_gear", machine: "anvil", time: 4.0,
     inputs: [("bronze_ingot", 2)], outputs: [("bronze_gear", 1)]),
    (id: "anvil_steel_rod", machine: "anvil", time: 4.0,
     inputs: [("steel_ingot", 1)], outputs: [("steel_rod", 2)], tech: Some("steelmaking")),
    (id: "anvil_steel_cable", machine: "anvil", time: 4.0,
     inputs: [("steel_rod", 1)], outputs: [("steel_cable", 2)], tech: Some("steelmaking")),
    (id: "anvil_hardened_pickaxe", machine: "anvil", time: 12.0,
     inputs: [("steel_ingot", 6), ("iron_rod", 2)], outputs: [("hardened_pickaxe", 1)],
     tech: Some("steelmaking")),
    (id: "anvil_steel_support", machine: "anvil", time: 5.0,
     inputs: [("steel_plate", 2)], outputs: [("steel_support", 2)], tech: Some("steelmaking")),
    (id: "anvil_steel_plate_block", machine: "anvil", time: 5.0,
     inputs: [("steel_plate", 2)], outputs: [("steel_plate_block", 1)], tech: Some("steelmaking")),

    // ===== BLAST FURNACE (Era 1 steel) ====================================
    (id: "blast_steel", machine: "blast_furnace", time: 12.0,
     inputs: [("iron_ingot", 2), ("coal", 2), ("limestone", 1)], outputs: [("steel_ingot", 2)],
     tech: Some("steelmaking")),
    (id: "blast_fire_brick", machine: "blast_furnace", time: 8.0,
     inputs: [("bricks", 4), ("limestone", 2)], outputs: [("fire_brick", 4)], tech: Some("steelmaking")),

    // ===== CRUSHER (Era 2) ================================================
    (id: "crush_iron", machine: "crusher", time: 5.0,
     inputs: [("raw_iron", 2)], outputs: [("crushed_ore", 3)], tech: Some("ore_processing")),
    (id: "crush_copper", machine: "crusher", time: 5.0,
     inputs: [("raw_copper", 2)], outputs: [("crushed_ore", 3)], tech: Some("ore_processing")),
    (id: "crush_tin", machine: "crusher", time: 5.0,
     inputs: [("raw_tin", 2)], outputs: [("crushed_ore", 3)], tech: Some("ore_processing")),
    (id: "crush_lead", machine: "crusher", time: 5.0,
     inputs: [("raw_lead", 2)], outputs: [("crushed_ore", 3)], tech: Some("ore_processing")),
    (id: "crush_zinc", machine: "crusher", time: 5.0,
     inputs: [("raw_zinc", 2)], outputs: [("crushed_ore", 3)], tech: Some("ore_processing")),
    (id: "crush_bauxite", machine: "crusher", time: 6.0,
     inputs: [("raw_bauxite", 2)], outputs: [("crushed_ore", 3)], tech: Some("ore_processing")),
    (id: "crush_nickel", machine: "crusher", time: 6.0,
     inputs: [("raw_nickel", 2)], outputs: [("crushed_ore", 3)], tech: Some("ore_processing")),
    (id: "crush_tungsten", machine: "crusher", time: 7.0,
     inputs: [("raw_tungsten", 2)], outputs: [("crushed_ore", 3)], tech: Some("ore_processing")),
    (id: "crush_chromium", machine: "crusher", time: 6.0,
     inputs: [("raw_chromium", 2)], outputs: [("crushed_ore", 3)], tech: Some("ore_processing")),
    (id: "crush_zircon", machine: "crusher", time: 7.0,
     inputs: [("raw_zircon", 2)], outputs: [("crushed_ore", 3)], tech: Some("ore_processing")),
    (id: "crush_gold", machine: "crusher", time: 7.0,
     inputs: [("raw_gold", 2)], outputs: [("crushed_ore", 3)], tech: Some("ore_processing")),
    (id: "crush_uranium", machine: "crusher", time: 10.0,
     inputs: [("uranium_ore", 2)], outputs: [("crushed_uranium_ore", 3)], tech: Some("uranium_milling")),
    (id: "bench_steam_drill", machine: "workbench", time: 20.0,
     inputs: [("steel_plate", 20), ("brass_gear", 6), ("copper_pipe", 12), ("steam_canister", 1)],
     outputs: [("steam_drill", 1)], tech: Some("steam_drill")),
    (id: "bench_conveyor", machine: "workbench", time: 3.0,
     inputs: [("steel_plate", 1), ("iron_gear", 1)], outputs: [("conveyor", 4)], tech: Some("logistics")),
    (id: "bench_rail", machine: "workbench", time: 3.0,
     inputs: [("steel_rod", 1), ("timber", 2)], outputs: [("rail", 8)], tech: Some("logistics")),
    (id: "bench_steam_canister", machine: "workbench", time: 5.0,
     inputs: [("copper_plate", 2), ("steel_plate", 1)], outputs: [("steam_canister", 1)], tech: Some("steam_power")),
    (id: "bench_headlamp", machine: "workbench", time: 5.0,
     inputs: [("glass_lens", 1), ("copper_cable", 1), ("battery_pack", 1)], outputs: [("headlamp", 1)],
     tech: Some("electrification")),
    (id: "bench_brass_gear", machine: "anvil", time: 4.0,
     inputs: [("brass_ingot", 2)], outputs: [("brass_gear", 1)], tech: Some("steam_power")),
    (id: "bench_cooling_suit", machine: "workbench", time: 10.0,
     inputs: [("steel_plate", 4), ("copper_pipe", 4), ("battery_pack", 1)], outputs: [("cooling_suit", 1)],
     tech: Some("hazard_gear")),
    (id: "bench_respirator", machine: "workbench", time: 8.0,
     inputs: [("steel_plate", 2), ("circuit_mk1", 1), ("glass_lens", 1)], outputs: [("respirator", 1)],
     tech: Some("hazard_gear")),
    (id: "bench_hazmat_suit", machine: "workbench", time: 14.0,
     inputs: [("lead_shielding", 4), ("steel_plate", 4), ("circuit_mk1", 2)], outputs: [("hazmat_suit", 1)],
     tech: Some("hazard_gear")),
    (id: "bench_geiger_counter", machine: "workbench", time: 8.0,
     inputs: [("circuit_mk1", 1), ("glass_lens", 1), ("lead_plate", 1)], outputs: [("geiger_counter", 1)],
     tech: Some("hazard_gear")),
    (id: "crush_gravel", machine: "crusher", time: 3.0,
     inputs: [("stone_cobble", 2)], outputs: [("gravel", 2)], tech: Some("ore_processing")),

    // ===== ORE WASHER (Era 2) =============================================
    (id: "wash_ore", machine: "ore_washer", time: 4.0,
     inputs: [("crushed_ore", 2)], outputs: [("washed_ore", 2)], tech: Some("ore_processing")),

    // ===== SMELTING THE RICHER INPUTS (Era 2+) ============================
    (id: "smelt_washed_iron", machine: "stone_furnace", time: 6.0,
     inputs: [("washed_ore", 2)], outputs: [("iron_ingot", 2)], tech: Some("ore_processing")),
    (id: "smelt_crushed_iron", machine: "stone_furnace", time: 6.0,
     inputs: [("crushed_ore", 2)], outputs: [("iron_ingot", 2)], tech: Some("ore_processing")),

    // ===== ARC FURNACE (Era 3) ============================================
    (id: "arc_silicon", machine: "arc_furnace", time: 8.0,
     inputs: [("quartz", 3), ("coal", 1)], outputs: [("silicon", 2)], tech: Some("electrification")),
    (id: "arc_aluminium", machine: "arc_furnace", time: 10.0,
     inputs: [("crushed_ore", 2), ("salt", 1)], outputs: [("aluminium_ingot", 2)], tech: Some("electrification")),
    (id: "arc_steel", machine: "arc_furnace", time: 8.0,
     inputs: [("iron_ingot", 2), ("coal", 1)], outputs: [("steel_ingot", 2)], tech: Some("electrification")),
    (id: "arc_nickel", machine: "arc_furnace", time: 9.0,
     inputs: [("raw_nickel", 2)], outputs: [("nickel_ingot", 2)], tech: Some("electrification")),
    (id: "arc_tungsten", machine: "arc_furnace", time: 12.0,
     inputs: [("raw_tungsten", 2)], outputs: [("tungsten_ingot", 2)], tech: Some("electrification")),
    (id: "arc_chromium", machine: "arc_furnace", time: 10.0,
     inputs: [("raw_chromium", 2)], outputs: [("chromium_ingot", 2)], tech: Some("electrification")),
    (id: "arc_zirconium", machine: "arc_furnace", time: 12.0,
     inputs: [("raw_zircon", 2)], outputs: [("zirconium_ingot", 2)], tech: Some("electrification")),

    // ===== ELECTROLYSIS (Era 3) ===========================================
    (id: "electro_chlorine_lye", machine: "electrolysis_cell", time: 8.0,
     inputs: [("salt", 2)], outputs: [("chlorine", 1), ("lye", 1)], tech: Some("electrification")),
    (id: "electro_aluminium", machine: "electrolysis_cell", time: 12.0,
     inputs: [("crushed_ore", 3)], outputs: [("aluminium_ingot", 3)], tech: Some("electrification")),
    (id: "electro_hydrogen_peroxide", machine: "electrolysis_cell", time: 10.0,
     inputs: [("lye", 2), ("chlorine", 1)], outputs: [("sulfuric_acid", 1)], tech: Some("chemistry")),

    // ===== CIRCUIT ASSEMBLER (Era 3) ======================================
    (id: "circuit_mk1", machine: "circuit_assembler", time: 6.0,
     inputs: [("silicon", 2), ("copper_cable", 2), ("copper_plate", 1)], outputs: [("circuit_mk1", 1)],
     tech: Some("electrification")),
    (id: "circuit_mk2", machine: "circuit_assembler", time: 10.0,
     inputs: [("circuit_mk1", 2), ("gold_ingot", 1)], outputs: [("circuit_mk2", 1)],
     tech: Some("circuitry")),
    (id: "battery_pack", machine: "circuit_assembler", time: 8.0,
     inputs: [("lead_plate", 1), ("sulfuric_acid", 1), ("copper_plate", 1)], outputs: [("battery_pack", 1)],
     tech: Some("electrification")),
    (id: "glass_lens", machine: "circuit_assembler", time: 5.0,
     inputs: [("glass_pane", 2), ("quartz", 1)], outputs: [("glass_lens", 1)], tech: Some("electrification")),
    (id: "speed_module", machine: "circuit_assembler", time: 10.0,
     inputs: [("circuit_mk1", 1), ("iron_gear", 1), ("copper_cable", 2)], outputs: [("speed_module", 1)],
     tech: Some("electrification")),
    (id: "efficiency_module", machine: "circuit_assembler", time: 10.0,
     inputs: [("circuit_mk1", 1), ("glass_lens", 1), ("copper_plate", 2)], outputs: [("efficiency_module", 1)],
     tech: Some("electrification")),
    (id: "electric_lamp", machine: "circuit_assembler", time: 4.0,
     inputs: [("glass_pane", 1), ("copper_cable", 1), ("steel_plate", 1)], outputs: [("electric_lamp", 1)],
     tech: Some("electrification")),

    // ===== CHEMICAL PLANT (Era 4) =========================================
    (id: "chem_sulfuric_acid", machine: "chemical_plant", time: 10.0,
     inputs: [("sulfur", 2), ("salt", 1)], outputs: [("sulfuric_acid", 2)], tech: Some("chemistry")),
    (id: "chem_fluorine", machine: "chemical_plant", time: 12.0,
     inputs: [("fluorite", 2), ("sulfuric_acid", 1)], outputs: [("fluorine_compound", 1)], tech: Some("chemistry")),
    (id: "chem_salt_split", machine: "chemical_plant", time: 8.0,
     inputs: [("salt", 2)], outputs: [("chlorine", 2)], tech: Some("chemistry")),

    // ===== ALLOY FURNACE (Era 4) ==========================================
    (id: "alloy_stainless", machine: "alloy_furnace", time: 14.0,
     inputs: [("steel_ingot", 4), ("nickel_ingot", 1), ("chromium_ingot", 1)],
     outputs: [("stainless_plate", 3)], tech: Some("advanced_materials")),
    (id: "alloy_tungsten_carbide", machine: "alloy_furnace", time: 16.0,
     inputs: [("tungsten_ingot", 2), ("graphite", 2)], outputs: [("tungsten_carbide", 2)],
     tech: Some("advanced_materials")),
    (id: "alloy_steel_gear", machine: "alloy_furnace", time: 8.0,
     inputs: [("steel_ingot", 2)], outputs: [("steel_gear", 1)], tech: Some("advanced_materials")),
    (id: "alloy_graphite_moderator", machine: "alloy_furnace", time: 10.0,
     inputs: [("graphite", 3), ("steel_plate", 1)], outputs: [("graphite_moderator", 1)],
     tech: Some("reactor_engineering")),
    (id: "alloy_reactor_casing", machine: "alloy_furnace", time: 12.0,
     inputs: [("stainless_plate", 2), ("lead_plate", 1)], outputs: [("reactor_casing", 1)],
     tech: Some("reactor_engineering")),
    (id: "alloy_lead_shielding", machine: "alloy_furnace", time: 8.0,
     inputs: [("lead_plate", 3)], outputs: [("lead_shielding", 1)], tech: Some("advanced_materials")),
    (id: "alloy_dense_shielding", machine: "alloy_furnace", time: 14.0,
     inputs: [("depleted_canister", 1), ("lead_plate", 2)], outputs: [("dense_shielding_plate", 1)],
     tech: Some("waste_handling")),

    // ===== MACHINE SHOP (Era 4) ===========================================
    (id: "shop_bearing", machine: "machine_shop", time: 8.0,
     inputs: [("steel_ingot", 1), ("tungsten_carbide", 1)], outputs: [("bearing", 2)],
     tech: Some("advanced_materials")),
    (id: "shop_turbine_blade", machine: "machine_shop", time: 12.0,
     inputs: [("stainless_plate", 2), ("bearing", 1)], outputs: [("turbine_blade", 1)],
     tech: Some("advanced_materials")),
    (id: "shop_centrifuge_rotor", machine: "machine_shop", time: 14.0,
     inputs: [("stainless_plate", 2), ("bearing", 2), ("tungsten_carbide", 1)],
     outputs: [("centrifuge_rotor", 1)], tech: Some("advanced_materials")),
    (id: "shop_stainless_rotor", machine: "machine_shop", time: 16.0,
