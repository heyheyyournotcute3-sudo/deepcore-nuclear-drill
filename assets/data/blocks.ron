// Deepcore block definitions.
//
// hardness      seconds to break with a tier-1 tool
// min_tier      lowest tool tier that can break it
// drops         [(item, count)]
// color         base colour (linear rgb)
// pattern       Solid | Speckle | OreFleck((r,g,b)) | Bands | Cracks | Glow
// emissive      light emitted by the block, 0 = none
// radiation     Some((radius, dose_per_sec)) while placed
// solid         blocks movement (default true)
// unbreakable   cannot be mined
// layer_hint    which layer the block belongs to
// machine       machine spawned when placed
// liquid        water-like block
[
    // --- surface ---------------------------------------------------------
    (id: "grass", hardness: 0.6, min_tier: 1, drops: [("dirt", 1)],
     color: (0.24, 0.38, 0.16), pattern: Speckle, layer_hint: Some(1)),
    (id: "dirt", hardness: 0.6, min_tier: 1, drops: [("dirt", 1)],
     color: (0.32, 0.23, 0.15), pattern: Speckle, layer_hint: Some(1)),
    (id: "gravel", hardness: 0.7, min_tier: 1, drops: [("gravel", 1)],
     color: (0.38, 0.36, 0.34), pattern: Speckle, layer_hint: Some(1)),
    (id: "clay", hardness: 0.8, min_tier: 1, drops: [("clay", 1)],
     color: (0.44, 0.40, 0.36), pattern: Bands, layer_hint: Some(1)),
    (id: "sand", hardness: 0.5, min_tier: 1, drops: [("sand", 1)],
     color: (0.72, 0.64, 0.42), pattern: Speckle, layer_hint: Some(1)),
    (id: "log", hardness: 1.2, min_tier: 1, drops: [("timber", 2)],
     color: (0.26, 0.18, 0.10), pattern: Bands, layer_hint: Some(1)),
    (id: "leaves", hardness: 0.3, min_tier: 1, drops: [("timber", 1)],
     color: (0.16, 0.32, 0.12), pattern: Speckle, solid: true, layer_hint: Some(1)),

    // --- layer 2: shale beds --------------------------------------------
    (id: "stone", hardness: 1.6, min_tier: 1, drops: [("stone_cobble", 1)],
     color: (0.42, 0.42, 0.44), pattern: Speckle, layer_hint: Some(2)),
    (id: "limestone", hardness: 1.5, min_tier: 1, drops: [("limestone", 1)],
     color: (0.66, 0.64, 0.58), pattern: Bands, layer_hint: Some(2)),
    (id: "shale", hardness: 1.8, min_tier: 1, drops: [("stone_cobble", 1)],
     color: (0.28, 0.29, 0.32), pattern: Bands, layer_hint: Some(2)),
    (id: "coal_seam", hardness: 2.0, min_tier: 1, drops: [("coal", 2)],
     color: (0.12, 0.12, 0.13), pattern: OreFleck((0.05, 0.05, 0.05)), layer_hint: Some(2)),
    (id: "malachite", hardness: 2.2, min_tier: 1, drops: [("raw_copper", 2)],
     color: (0.30, 0.36, 0.34), pattern: OreFleck((0.24, 0.62, 0.44)), layer_hint: Some(2)),
    (id: "cassiterite", hardness: 2.2, min_tier: 1, drops: [("raw_tin", 2)],
     color: (0.34, 0.32, 0.30), pattern: OreFleck((0.62, 0.60, 0.55)), layer_hint: Some(2)),
    (id: "hematite", hardness: 2.6, min_tier: 1, drops: [("raw_iron", 2)],
     color: (0.36, 0.30, 0.28), pattern: OreFleck((0.70, 0.38, 0.26)), layer_hint: Some(2)),

    // --- layer 3: granite depths -----------------------------------------
    (id: "granite", hardness: 2.5, min_tier: 2, drops: [("granite_cobble", 1)],
