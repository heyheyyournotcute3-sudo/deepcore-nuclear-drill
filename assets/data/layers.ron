// The six depth layers, top to bottom. Depth is measured below the surface (tuning.surface_y).
// `filler` entries are picked pseudo-randomly per block; the base block fills the rest.
[
    (
        id: "topsoil",
        name: "Topsoil",
        depth: (0, 16),
        base_block: "dirt",
        filler: [("grass", 0.4), ("gravel", 1.0), ("clay", 0.8), ("sand", 0.6)],
        ores: [
            (block: "coal_seam", frequency: 0.05, vein_size: (4, 12)),
